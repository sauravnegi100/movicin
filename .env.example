# Movicin Environment Variables Example
# Duplicate this file to .env.local for local development.
# Never commit real secrets or production credentials to version control.

# Application Public Display & URL
NEXT_PUBLIC_APP_NAME="Movicin"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Managed Backend (Public Credentials)
# Project URL (Found under Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Publishable Key (Current convention, starts with sb_publishable_...)
# Safe for client-side exposure with Row Level Security (RLS) enabled.
# Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Supabase Server-Only Secret (Never expose to client or browser bundles)
# Master Secret Key (Current convention, starts with sb_secret_...)
# WARNING: Bypasses RLS. Strictly server-side only.
# Legacy SUPABASE_SERVICE_ROLE_KEY is also supported as a fallback.
SUPABASE_SECRET_KEY="your-secret-key"

# Movie Metadata Provider API Key (Server-only)
TMDB_API_KEY="your-tmdb-v3-or-v4-read-token"
